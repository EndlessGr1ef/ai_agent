{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Agent (src.main) - Chat",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Python: Agent (src.main) - RAG",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": [
        "--use-rag"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Python: Agent (src.main) - Chat + Compression",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": [
        "--enable-compression",
        "--max-tokens", "8000"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Python: Agent (src.main) - Memory Mode",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": [
        "--session-id", "session-${input:sessionId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Python: Agent (src.main) - RAG + Memory",
      "type": "python",
      "request": "launch",
      "module": "src.main",
      "args": [
        "--use-rag",
        "--session-id", "session-${input:sessionId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Python: Ingest Markdown (ingest_md.py)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/ingest_md.py",
      "args": [
        "--docs-dir", "${workspaceFolder}/docs"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Python: Chroma Query Tool",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/chroma_query_tool.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "sessionId",
      "description": "Enter a session ID for memory mode",
      "default": "default",
      "type": "promptString"
    }
  ]
}
