# ==============================================================================
# MiniMax API 配置文件
# ==============================================================================
# 复制此文件为 .env 并填入您的 API 密钥

# ------------------------------
# Anthropic SDK 配置（推荐）
# ------------------------------
# 使用 Anthropic SDK 调用 MiniMax 模型
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_TEMPERATURE=1.0
USE_ANTHROPIC=true

# ------------------------------
# OpenAI 兼容接口配置（备选）
# ------------------------------
# 如果您想使用 OpenAI 兼容接口，可以取消下面的注释
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# OPENAI_MODEL=MiniMax-M2
# OPENAI_SYSTEM_PROMPT=You are a helpful assistant.
# OPENAI_TEMPERATURE=0.5

# ==============================================================================
# 其他配置
# ==============================================================================

# ChromaDB 配置（用于 RAG 和记忆功能）
CHROMA_HOST=localhost
CHROMA_PORT=9000
CHROMA_COLLECTION=md_docs

# 记忆功能配置
MEMORY_COLLECTION=agent_memory
MEMORY_K=5

# 嵌入模型
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# 检索配置
TOP_K=4

# 请求超时（秒）
REQUEST_TIMEOUT=300

# 上下文压缩配置
MAX_TOKENS=80000

# 输出配置
# --show-thinking 或 --hide-thinking 控制思考过程显示
