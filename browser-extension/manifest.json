{
  "manifest_version": 3,
  "name": "AI Selection Search",
  "version": "1.0.0",
  "description": "AI-powered selection search with context awareness",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "index.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "host_permissions": ["<all_urls>"]
}
